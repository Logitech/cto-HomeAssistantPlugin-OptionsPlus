<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Loupedeck.HomeAssistantPlugin</RootNamespace>

    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>

    <!-- Conditional Compilation Symbols for Logging Levels -->
    <!-- For Beta/Development builds: Uncomment TRACE_LOGGING to enable all verbose logging -->
    <DefineConstants>$(DefineConstants);TRACE_LOGGING</DefineConstants>
    
    <!-- For Production builds with verbose logs: Uncomment VERBOSE_LOGGING -->
    <!-- <DefineConstants>$(DefineConstants);VERBOSE_LOGGING</DefineConstants> -->
    
    <!-- For Production builds with debug info: Uncomment DEBUG_LOGGING -->
    <!-- <DefineConstants>$(DefineConstants);DEBUG_LOGGING</DefineConstants> -->
    
    <!-- For Standard Production builds: Uncomment INFO_LOGGING (recommended default) -->
    <!-- <DefineConstants>$(DefineConstants);INFO_LOGGING</DefineConstants> -->
    
    <!-- For Minimal Production builds: Uncomment WARNING_LOGGING only -->
    <!-- <DefineConstants>$(DefineConstants);WARNING_LOGGING</DefineConstants> -->
    
    <!-- Note: ERROR_LOGGING is always enabled regardless of symbols -->

    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>

    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <BaseOutputPath>$(RepositoryRoot)bin/</BaseOutputPath>
    <PluginPackageRoot>$([MSBuild]::NormalizeDirectory('$(BaseOutputPath)', '$(Configuration)'))</PluginPackageRoot>
    <OutputPath>$(PluginPackageRoot)bin/</OutputPath>
    <PluginStagingDir>$(RepositoryRoot)artifacts/package/</PluginStagingDir>
    <PluginPackageFile>$(RepositoryRoot)artifacts/HomeAssistant.lplug4</PluginPackageFile>
    <PluginLinkFile Condition="'$(PluginDir)' != ''">$([MSBuild]::NormalizePath('$(PluginDir)', '$(MSBuildProjectName).link'))</PluginLinkFile>

    <PluginShortName>HomeAssistant</PluginShortName>
    <DeployPlugin Condition="'$(DeployPlugin)' == ''">true</DeployPlugin>
    <ReloadPlugin Condition="'$(ReloadPlugin)' == ''">true</ReloadPlugin>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\icons\light_bulb_icon.svg">
      <LogicalName>light_bulb_icon.svg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\icons\back_icon.svg">
      <LogicalName>back_icon.svg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\icons\light_on_icon.svg">
      <LogicalName>light_on_icon.svg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\icons\light_off_icon.svg">
      <LogicalName>light_off_icon.svg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\icons\brightness_icon.svg">
      <LogicalName>brightness_icon.svg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\icons\reload_icon.svg">
      <LogicalName>reload_icon.svg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\icons\saturation_icon.svg">
      <LogicalName>saturation_icon.svg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\icons\issue_status_icon.svg">
      <LogicalName>issue_status_icon.svg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\icons\temperature_icon.svg">
      <LogicalName>temperature_icon.svg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\icons\online_status_icon.png">
      <LogicalName>online_status_icon.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\icons\hue_icon.svg">
      <LogicalName>hue_icon.svg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\icons\area_icon.svg">
      <LogicalName>area_icon.svg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\icons\run_script_icon.svg">
      <LogicalName>run_script_icon.svg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\icons\switch_icon.svg">
      <LogicalName>switch_icon.svg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\icons\switch_on_icon.svg">
      <LogicalName>switch_on_icon.svg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\icons\switch_off_icon.svg">
      <LogicalName>switch_off_icon.svg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\icons\area_switch_icon.svg">
      <LogicalName>area_switch_icon.svg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\icons\multiple_switches_icon.svg">
      <LogicalName>multiple_switches_icon.svg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\icons\cover_close_icon.svg">
      <LogicalName>cover_close_icon.svg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\icons\cover_open_icon.svg">
      <LogicalName>cover_open_icon.svg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\icons\cover_stop_icon.svg">
      <LogicalName>cover_stop_icon.svg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\icons\cover_icon.svg">
      <LogicalName>cover_icon.svg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\icons\cover_tilt_icon.svg">
