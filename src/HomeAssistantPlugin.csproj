      <LogicalName>multiple_covers_icon.svg</LogicalName>
    </EmbeddedResource>
    
  </ItemGroup>

  <Target Name="CopyPackage" AfterTargets="CopyFilesToOutputDirectory">
    <ItemGroup>
      <PackageFiles Include="package\**\*" />
      <FileWrites Include="@(PackageFiles->'$(PluginPackageRoot)%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>
    <Copy SourceFiles="@(PackageFiles)" DestinationFolder="$(PluginPackageRoot)%(RecursiveDir)" />
  </Target>

  <Target Name="WritePluginLink" AfterTargets="CopyPackage" Condition="'$(DeployPlugin)' == 'true'">
    <Error Condition="'$(PluginDir)' == ''" Text="Local deployment requires Windows/macOS or an explicit PluginDir. Use -p:DeployPlugin=false for SDK-only builds." />
    <MakeDir Directories="$(PluginDir)" />
    <WriteLinesToFile File="$(PluginLinkFile)"
                      Lines="$(PluginPackageRoot)" Overwrite="true" Encoding="UTF-8" />
    <Message Text="Created development link in $(PluginDir)" Importance="High" />
  </Target>

  <Target Name="ReloadLocalPlugin" AfterTargets="WritePluginLink" Condition="'$(DeployPlugin)' == 'true' and '$(ReloadPlugin)' == 'true'">
    <Exec Condition="'$(IsWindows)' == 'true'" Command="start &quot;&quot; &quot;loupedeck://plugin/$(PluginShortName)/reload&quot;" ContinueOnError="WarnAndContinue" />
    <Exec Condition="'$(IsMacOS)' == 'true'" Command="open &quot;loupedeck://plugin/$(PluginShortName)/reload&quot;" ContinueOnError="WarnAndContinue" />
  </Target>

  <Target Name="PluginClean" AfterTargets="CoreClean" Condition="'$(DeployPlugin)' == 'true' and '$(PluginDir)' != ''">
    <ReadLinesFromFile File="$(PluginLinkFile)" Condition="Exists('$(PluginLinkFile)')">
      <Output TaskParameter="Lines" ItemName="_CurrentPluginLink" />
    </ReadLinesFromFile>
    <Delete Files="$(PluginLinkFile)" Condition="'@(_CurrentPluginLink)' == '$(PluginPackageRoot)'" />
  </Target>

  <Target Name="ValidatePackaging">
    <Error Condition="'$(DeployPlugin)' != 'false'" Text="Packaging requires -p:DeployPlugin=false to avoid changing the local host." />
  </Target>

  <Target Name="StagePlugin" DependsOnTargets="ValidatePackaging;Build">
    <RemoveDir Directories="$(PluginStagingDir)" />
    <ItemGroup>
      <_PackageAssets Include="$(MSBuildProjectDirectory)/package/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PackageAssets)" DestinationFolder="$(PluginStagingDir)%(RecursiveDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginStagingDir)bin/" />
    <Copy SourceFiles="@(ReferenceCopyLocalPaths)" DestinationFiles="@(ReferenceCopyLocalPaths->'$(PluginStagingDir)bin/%(DestinationSubPath)')" />
  </Target>

  <Target Name="PackPlugin" DependsOnTargets="StagePlugin">
    <Exec Command="dotnet tool run logiplugintool pack &quot;$(PluginStagingDir)&quot; &quot;$(PluginPackageFile)&quot;" WorkingDirectory="$(RepositoryRoot)" />
    <Exec Command="dotnet tool run logiplugintool verify &quot;$(PluginPackageFile)&quot;" WorkingDirectory="$(RepositoryRoot)" />
  </Target>
</Project>
